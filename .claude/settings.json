{
  "permissions": {
    "allow": [
      "Bash(pnpm install:*)",
      "Bash(pnpm add:*)",
      "Bash(pnpm run:*)",
      "Bash(pnpm test:*)",
      "Bash(pnpm dev:*)",
      "Bash(pnpm build:*)",
      "Bash(pnpm check:*)",
      "Bash(pnpm db:*)",
      "Bash(pnpm exec:*)",
      "Bash(pnpm -r:*)",
      "Bash(pnpm --filter:*)",
      "Bash(node:*)",
      "Bash(npx:*)",
      "Bash(tsx:*)",
      "Bash(wrangler dev:*)",
      "Bash(wrangler d1:*)",
      "Bash(wrangler r2 object:*)",
      "Bash(wrangler types:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git branch:*)",
      "Bash(git show:*)",
      "Bash(git remote -v:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git checkout:*)",
      "Bash(git switch:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh issue view:*)",
      "Bash(gh issue list:*)",
      "Bash(curl -s https://api.github.com/*)",
      "Bash(curl -s https://matatabetai.shiraoka.workers.dev/*)",
      "Bash(docker compose exec:*)",
      "Bash(scripts/ci-status.sh:*)",
      "Bash(./scripts/ci-status.sh:*)",
      "WebFetch(domain:matatabetai.shiraoka.workers.dev)",
      "WebFetch(domain:code.claude.com)",
      "WebFetch(domain:developers.cloudflare.com)",
      "WebFetch(domain:docs.mcp.cloudflare.com)"
    ],
    "deny": [
      "Bash(git push:*)"
    ]
  },
  "enableAllProjectMcpServers": false,
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/block-main-commit.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/require-container.py",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
