{
  "name": "matatabetai",
  "private": true,
  "scripts": {
    "dev": "pnpm --filter @matatabetai/web dev",
    "build": "pnpm --filter @matatabetai/web build",
    "deploy": "pnpm --filter @matatabetai/web run deploy",
    "check": "pnpm --filter @matatabetai/web check",
    "ci": "pnpm -r run check && pnpm -r run build",
    "types": "pnpm --filter @matatabetai/web types",
    "db:migrate": "pnpm --filter @matatabetai/web db:migrate",
    "db:migrate:prod": "pnpm --filter @matatabetai/web db:migrate:prod"
  },
  "packageManager": "pnpm@11.22.0",
  "engines": { "node": ">=24" }
}
