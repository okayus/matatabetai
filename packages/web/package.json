{
  "name": "@matatabetai/web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "deploy": "pnpm build && wrangler deploy",
    "types": "wrangler types --strict-vars=false",
    "check": "pnpm types && tsc --noEmit",
    "db:migrate": "wrangler d1 migrations apply matatabetai --local",
    "db:migrate:prod": "wrangler d1 migrations apply matatabetai --remote"
  },
  "dependencies": {
    "hono": "^4.13.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.53.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "wrangler": "^4.125.0"
  }
}
