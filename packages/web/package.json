{
  "name": "@matatabetai/web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "deploy": "pnpm build && wrangler deploy",
    "types": "wrangler types --strict-vars=false",
    "check": "pnpm types && tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:check": "drizzle-kit check",
    "db:migrate": "wrangler d1 migrations apply matatabetai --local",
    "db:migrate:prod": "wrangler d1 migrations apply matatabetai --remote",
    "e2e": "playwright test",
    "e2e:server": "pnpm build && wrangler dev --config dist/matatabetai/wrangler.json --persist-to .wrangler/state --ip 127.0.0.1 --port 5183 --var ORIGIN:http://localhost:5183 --var RP_ID:localhost --var SESSION_SECRET:e2e-secret-0123456789abcdef0123456789abcdef --var INITIAL_REGISTRATION_TOKEN:e2e-initial-token"
  },
  "dependencies": {
    "@simplewebauthn/server": "^13.3.3",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.13.3",
    "neverthrow": "^8.2.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.5.2"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.53.1",
    "@playwright/test": "1.62.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "drizzle-kit": "^0.31.10",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.125.0"
  }
}
