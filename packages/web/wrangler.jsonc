{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "matatabetai",
  "compatibility_date": "2025-03-28",
  "main": "./worker/index.ts",
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "vars": {
    // RP_ID は本番ホストに固定済（WebAuthn 採用時の credential 不変性のため、ここを変えると全 credential が無効化）。
    // ローカル開発で localhost ホスト名を使いたい場合は packages/web/.dev.vars 側で上書きする。
    "RP_ID": "matatabetai.shiraoka.workers.dev",
    "ORIGIN": "https://matatabetai.shiraoka.workers.dev"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "matatabetai",
      "database_id": "58a6232f-2847-4f9b-936f-725704d1fb61",
      "migrations_dir": "drizzle"
    }
  ]
}
