# Sandbox GitHub token — resolved by `op run` on the host inside ./shell.sh (per shell,
# never in the container config).
# This file holds a 1Password secret REFERENCE (op://...), never a value.
# Copy to .docker/sandbox.env (gitignored) and point it at your vault/item:
#   op item create --category "API Credential" --vault "Private" \
#     --title "github-pat-matatabetai-sandbox" 'credential=<token>' 'expires=<YYYY-MM-DD>'
# Token scope: okayus/matatabetai only · Contents + Pull requests · no Workflows · 90 days.
GH_TOKEN="op://Private/github-pat-matatabetai-sandbox/credential"
